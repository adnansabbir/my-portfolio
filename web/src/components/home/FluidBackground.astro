---

<div class="fixed inset-0">
	<div id="fluid-container" class="h-full w-full"></div>
</div>

<script>
	import { fluidThemes } from '@/data/home';

	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const isMobileViewport = !window.matchMedia('(min-width: 768px)').matches;

	const supportsWebGL = (() => {
		try {
			const canvas = document.createElement('canvas');
			return Boolean(canvas.getContext('webgl2') || canvas.getContext('webgl'));
		} catch {
			return false;
		}
	})();

	const getTheme = () => (document.documentElement.classList.contains('dark') ? fluidThemes.dark : fluidThemes.light);

	const runWhenIdle = window.requestIdleCallback ?? ((cb: IdleRequestCallback) => setTimeout(cb, 1));

	// Starting the simulation is a long main-thread task (shader compile +
	// first frames); waiting for load too keeps it off the page's Total
	// Blocking Time instead of competing with earlier page activity.
	const runWhenLoadedAndIdle = (cb: () => void) => {
		if (document.readyState === 'complete') {
			runWhenIdle(cb);
		} else {
			window.addEventListener('load', () => runWhenIdle(cb), { once: true });
		}
	};

	if (!prefersReducedMotion && !isMobileViewport && supportsWebGL) {
		const container = document.getElementById('fluid-container') as HTMLElement;

		runWhenLoadedAndIdle(() => {
			import('webgl-fluid-enhanced').then(({ default: WebGLFluidEnhanced }) => {
				const theme = getTheme();

				const fluid = new WebGLFluidEnhanced(container);
				fluid.setConfig({
					transparent: true,
					shading: false,
					bloom: false,
					sunrays: false,
					splatForce: 2000,
					curl: 8,
					velocityDissipation: 0.15,
					densityDissipation: 0.8,
					brightness: theme.brightness,
					colorPalette: theme.palette,
				});
				fluid.start();

				window.addEventListener('theme-change', () => {
					const theme = getTheme();
					fluid.setConfig({ colorPalette: theme.palette, brightness: theme.brightness });
				});
			});
		});
	}
</script>
